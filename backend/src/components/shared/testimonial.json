{
  "collectionName": "components_shared_testimonials",
  "info": {
    "displayName": "Testimonial",
    "description": "Depoimento de cliente com foto, nome, avaliação e conteúdo",
    "icon": "quote"
  },
  "options": {},
  "attributes": {
    "author_name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "author_role": {
      "type": "string",
      "maxLength": 100
    },
    "author_photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 1000
    },
    "rating": {
      "type": "decimal",
      "min": 0,
      "max": 5,
      "default": 5
    },
    "badge_text": {
      "type": "string",
      "maxLength": 50,
      "default": "Compra verificada"
    },
    "verified": {
      "type": "boolean",
      "default": true
    }
  }
}
