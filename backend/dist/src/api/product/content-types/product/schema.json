{
    "kind": "collectionType",
    "collectionName": "products",
    "info": {
        "singularName": "product",
        "pluralName": "products",
        "displayName": "Product",
        "description": "Produtos do ecossistema com SEO pages e LPs"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 200
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true
        },
        "description": {
            "type": "richtext"
        },
        "short_description": {
            "type": "text",
            "maxLength": 200
        },
        "checkout_base_url": {
            "type": "string",
            "required": true,
            "maxLength": 500
        },
        "price": {
            "type": "decimal",
            "required": true,
            "min": 0
        },
        "price_original": {
            "type": "decimal",
            "min": 0
        },
        "currency": {
            "type": "enumeration",
            "enum": ["BRL", "USD", "EUR"],
            "default": "BRL",
            "required": true
        },
        "featured_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images"]
        },
        "gallery": {
            "type": "media",
            "multiple": true,
            "allowedTypes": ["images"]
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "seo_pages": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::seo-page.seo-page",
            "mappedBy": "product"
        },
        "landing_pages": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::landing-page.landing-page",
            "mappedBy": "product"
        },
        "testimonials": {
            "type": "component",
            "repeatable": true,
            "component": "shared.testimonial"
        },
        "faq": {
            "type": "component",
            "repeatable": true,
            "component": "shared.faq-item"
        },
        "trust_badges": {
            "type": "component",
            "repeatable": true,
            "component": "shared.trust-badge"
        },
        "guarantee_text": {
            "type": "string",
            "maxLength": 200
        },
        "guarantee_days": {
            "type": "integer",
            "default": 30,
            "min": 1,
            "max": 365
        },
        "safe_page_slug": {
            "type": "string",
            "maxLength": 200
        }
    }
}
