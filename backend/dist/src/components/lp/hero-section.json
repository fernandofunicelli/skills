{
    "collectionName": "components_lp_hero_sections",
    "info": {
        "displayName": "LP Hero Section",
        "description": "Hero section da Landing Page com badge, headline, imagem/vídeo e CTA",
        "icon": "star"
    },
    "options": {},
    "attributes": {
        "badge_text": {
            "type": "string",
            "maxLength": 100
        },
        "headline": {
            "type": "string",
            "required": true,
            "maxLength": 200
        },
        "sub_headline": {
            "type": "text",
            "required": true,
            "maxLength": 500
        },
        "hero_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images"]
        },
        "hero_video_url": {
            "type": "string",
            "maxLength": 500
        },
        "cta_text": {
            "type": "string",
            "required": true,
            "maxLength": 100,
            "default": "QUERO COMEÇAR AGORA"
        },
        "trust_items": {
            "type": "component",
            "repeatable": true,
            "component": "shared.trust-badge"
        }
    }
}
