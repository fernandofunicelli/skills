# ============================================
# VARIÁVEIS DE AMBIENTE - PAYLOAD CMS + NEXT.JS
# ============================================

# URLBase onde seu Next.js / Payload CMS está rodando (usado nos redirects, API, etc.)
NEXT_PUBLIC_SERVER_URL=https://seudominio.com

# URL do Banco de Dados PostgreSQL (Obrigatório para o Payload)
# Exemplo se for banco externo: postgresql://user:password@host:5432/dbname
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/brazapp

# Chave Super-secreta de Segurança (criptografia JSON Web Tokens do Payload)
# Gere no terminal com `openssl rand -hex 32` ou coloque uma string forte de 32 caracteres.
PAYLOAD_SECRET=sua-super-chave-secreta-aqui-1234567

# Google Tag Manager (opcional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Segurança Webhooks de Revalidação
REVALIDATE_SECRET=seu-secret-aqui
