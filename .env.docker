# ============================================
# .env.docker — Variáveis de produção para o EasyPanel
# ============================================

# ── BANCO DE DADOS (PostgreSQL — EasyPanel) ──
DATABASE_HOST=p2p_conteudo-db
DATABASE_PORT=5432
DATABASE_NAME=conteudo-db
DATABASE_USERNAME=userconteudo
DATABASE_PASSWORD=9c3af421fbdbe277bf52
DATABASE_SSL=false

# ── STRAPI SECRETS ──
# Gerar com: openssl rand -base64 32
STRAPI_APP_KEYS=GERAR_4_CHAVES_BASE64_SEPARADAS_POR_VIRGULA
STRAPI_API_TOKEN_SALT=GERAR_ALEATÓRIO
STRAPI_ADMIN_JWT_SECRET=GERAR_ALEATÓRIO
STRAPI_TRANSFER_TOKEN_SALT=GERAR_ALEATÓRIO
STRAPI_ENCRYPTION_KEY=GERAR_ALEATÓRIO
STRAPI_JWT_SECRET=GERAR_ALEATÓRIO

# ── STRAPI API TOKEN (gerar no painel /admin após primeiro deploy) ──
STRAPI_API_TOKEN=PREENCHER_APÓS_PRIMEIRO_DEPLOY

# ── FRONTEND ──
NEXT_PUBLIC_SITE_URL=https://seudominio.com
# NEXT_PUBLIC_STRAPI_URL não precisa configurar — usa http://backend:1337 por padrão
REVALIDATE_SECRET=GERAR_UUID_ALEATÓRIO
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
